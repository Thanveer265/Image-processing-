APP_NAME="ImageLab Backend"
APP_VERSION="1.0.0"
HOST="127.0.0.1"
PORT=8001
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
MAX_UPLOAD_SIZE_MB=20
DATABASE_URL="sqlite:///./imagelab.db"
STORAGE_DIR="./storage"
MODELS_DIR="./app/models"
LOG_LEVEL="INFO"

# Secure ResNet50 Checkpoint Download (Server-side Python backend only — never expose to frontend)
# File ID of ImageLab/trained_model/resnet50_brain_tumor.pth in Google Drive
GOOGLE_DRIVE_FILE_ID=""

# Option A (Recommended): Path to Google Cloud Service Account JSON key file on the Python host
GOOGLE_DRIVE_CREDENTIALS_PATH=""

# Option B (PaaS / Containers): Raw or base64-encoded Service Account JSON string
GOOGLE_DRIVE_CREDENTIALS_JSON=""

# Option C (One-time setup): Short-lived OAuth2 Bearer access token with drive.readonly scope
GOOGLE_DRIVE_ACCESS_TOKEN=""

# Integrity verification (set to the exact 64-char hex SHA-256 of your original .pth checkpoint)
MODEL_EXPECTED_SHA256=""
MODEL_MIN_SIZE_BYTES=10000000
MODEL_MAX_SIZE_BYTES=500000000

# Model lifecycle flags
# Keep MODEL_AUTO_DOWNLOAD_ON_STARTUP=false if you run `python scripts/download_model.py` during deploy
MODEL_AUTO_DOWNLOAD_ON_STARTUP=false
MODEL_PRELOAD_ON_STARTUP=true

